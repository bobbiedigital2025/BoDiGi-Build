# BoDiGi-Build Backend — copy to .env and fill in your values
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

JWT_SECRET=change-me-to-a-random-secret
MCP_SECRET=change-me-to-a-random-secret
DEPLOYMENT_PROFILE_MODE=user-preferred
# Use locked-default to prevent per-request deployment profile overrides.
DEFAULT_DEPLOYMENT_PROFILE=vercel-docker-n8n
MCP_PROTOCOL_VERSION=2
MCP_AUTO_FETCH_TTL_MS=60000
A2A_HANDOFF_SECRET=change-me-to-a-shared-handoff-secret
# Optional JSON array of MCP seed servers.
# MCP_DISCOVERY_SEED=[{"id":"mcp-primary","name":"Primary MCP","url":"https://mcp-primary.example.com","priority":100,"status":"online","capabilities":["context-fetch","skills"]}]

OPENAI_API_KEY=sk-...
